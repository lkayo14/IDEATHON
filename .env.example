# ==============================================================================
# Marketplace WhatsApp com IA - Configuração de Ambiente
# ==============================================================================

# Porta do Servidor Backend
PORT=3001

# Banco de Dados (SQLite por padrão para desenvolvimento local zero-config)
# Para Railway/Postgres: postgresql://postgres:senha@host:5432/railway
DATABASE_URL="file:./dev.db"

# ==============================================================================
# Inteligência Artificial: Google Gemini (SDK Oficial @google/genai)
# ==============================================================================
# Se a chave NÃO for informada, o sistema inicia automaticamente em MODO DEMONSTRAÇÃO
# exibindo badge explicativa e executando todas as operações comerciais perfeitamente.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ==============================================================================
# Opção A: Z-API (WhatsApp via QR Code / Instância - z-api.io) [RECOMENDADO]
# ==============================================================================
# Crie uma instância no painel da Z-API, escaneie o QR Code e preencha abaixo:
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
ZAPI_CLIENT_TOKEN="" # Opcional (se configurado no painel da Z-API)
# Webhook da Z-API: configure no painel da Z-API para:
# https://seu-link.ngrok-free.app/api/whatsapp/zapi/webhook

# ==============================================================================
# Opção B: WhatsApp Cloud API Oficial (Meta for Developers)
# ==============================================================================
# Se as credenciais da Meta NÃO forem informadas e a Z-API também não,
# utilize o Simulador Web integrado no frontend (funciona 100% de imediato).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="ideathon_verify_token_123"

# ==============================================================================
# Armazenamento e URLs
# ==============================================================================
BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"

# Opcional: Supabase / S3 para imagens na nuvem
# STORAGE_PROVIDER="local" # "local" ou "supabase"
# SUPABASE_URL=""
# SUPABASE_KEY=""
# SUPABASE_BUCKET="marketplace-images"
